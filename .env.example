DATABASE_URL=
SQUAD_SECRET_KEY=
SQUAD_PUBLIC_KEY=
GEMINI_API_KEY=
JWT_ACCESS_SECRET=
GEMINI_MODEL=
PORT=
APP_PUBLIC_URL=
PLATFORM_FEE_BP=

# ── Email (Resend) — reset codes, weekly reports, staff invites. https://resend.com
# Without a key, emails are written to the log instead.
RESEND_API_KEY=
EMAIL_FROM="BrainBox <hello@your-domain.com>"

# ── WhatsApp (Meta Cloud API, no middleman). Optional: parents opt in; each message costs ~₦10–14.
# Without these, WhatsApp messages are written to the log instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LANGUAGE=en
WHATSAPP_CODE_TEMPLATE=nexus_code
WHATSAPP_REPORT_TEMPLATE=weekly_report

# ── Push notifications (Expo push service). Only needed if you turn on "enhanced security" in Expo.
EXPO_ACCESS_TOKEN=
# Hard monthly ceiling on all AI spend, in dollars (0 = none). When it's reached, AI stops and the app uses non-AI fallbacks.
AI_MONTHLY_BUDGET_USD=
# Earn while you learn: most paid out in airtime/data per month, for everyone together (default 30000).
REWARDS_MONTHLY_BUDGET_NAIRA=30000
